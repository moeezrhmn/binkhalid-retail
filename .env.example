# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/binkhalid_retail?schema=public"

# Signs the login session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# The default admin account, created by `npm run db:seed`. The password is only
# used when no admin exists yet; remove it from the server's .env after the first seed.
ADMIN_USERNAME="admin"
ADMIN_NAME="Admin"
ADMIN_PASSWORD=""

# Where product images are stored. Include this folder in backups.
UPLOAD_DIR="./uploads"
