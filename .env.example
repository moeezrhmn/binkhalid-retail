# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/binkhalid_retail?schema=public"

# Signs the login session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# The single admin account, created by `npm run db:seed`.
# The password is only used when the admin does not exist yet.
ADMIN_USERNAME="admin"
ADMIN_NAME="Admin"
ADMIN_PASSWORD=""
